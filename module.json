      {
        "id": "dnd5e",
        "type": "system",
        "compatibility": {
          "minimum": "5.0.0",
          "verified": "5.0.4"
        }
      }
    ]
  },
  "socket": true,
  "flags": {
    "hotReload": {
      "extensions": ["css", "hbs", "json"]
    }
  }
